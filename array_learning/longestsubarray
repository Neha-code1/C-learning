#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter size:\n";
    cin >> n;

    int arr[n], i;

    for(i = 0; i < n; i++) {
        cout << "Enter element: ";
        cin >> arr[i];
        cout << "\n";
    }

    int k;
    cout << "Enter the sum of subarray: ";
    cin >> k;

    int maxlen = 0, len = 0;

    for(i = 0; i < n; i++) {

        int sum = 0;

        for(int j = i; j < n; j++) {

            sum += arr[j];

            if(sum == k) {
                len = j - i + 1;

                if(len > maxlen) {
                    maxlen = len;
                }
            }
        }
    }

    cout << "Longest subarray length = " << maxlen;

    return 0;
}